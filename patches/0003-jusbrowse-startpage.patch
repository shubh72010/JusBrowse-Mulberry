+package org.mozilla.fenix.jusbrowse
+
+import androidx.compose.foundation.background
+import androidx.compose.foundation.layout.Box
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.remember
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.graphics.Brush
+import androidx.compose.ui.graphics.Color
+
+enum class JusBrowseBackgroundPreset(val colors: List<Color>) {
+    NONE(emptyList()),
+    WALLPAPER_BLUE1(listOf(Color(0xFF0F172A), Color(0xFF1E40AF))),
+    WALLPAPER_GREEN1(listOf(Color(0xFF052E16), Color(0xFF16A34A))),
+    WALLPAPER_DARK1(listOf(Color(0xFF09090B), Color(0xFF27272A))),
+    GOLDEN(listOf(Color(0xFF422006), Color(0xFFF59E0B))),
+    ;
+    companion object { fun fromName(name: String) = values().find { it.name == name } ?: NONE }
+}
+
+@Composable
+fun JusBrowseStartPageBackground(presetName: String = "NONE", modifier: Modifier = Modifier) {
+    val preset = remember(presetName) { JusBrowseBackgroundPreset.fromName(presetName) }
+    if (preset == JusBrowseBackgroundPreset.NONE || preset.colors.isEmpty()) return
+    val brush = remember(preset) {
+        if (preset.colors.size == 1) Brush.verticalGradient(listOf(preset.colors[0], preset.colors[0]))
+        else Brush.verticalGradient(preset.colors)
+    }
+    Box(modifier = modifier.fillMaxSize().background(brush))
+}
