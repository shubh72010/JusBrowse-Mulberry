+
+package org.mozilla.fenix.settings
+
+import android.content.Context
+import android.util.AttributeSet
+import android.view.View
+import android.view.View.GONE
+import android.view.View.VISIBLE
+import android.widget.ImageView
+import androidx.preference.PreferenceViewHolder
+import org.mozilla.fenix.GleanMetrics.CustomizationSettings
+import org.mozilla.fenix.R
+import org.mozilla.fenix.ext.components
+import org.mozilla.fenix.nimbus.FxNimbus
+import org.mozilla.fenix.utils.view.addToRadioGroup
+
+const val EXPANDED_SECOND_TOOLBAR_TYPE = "expanded_second"
+
+internal class ToolbarExpandedSecondShortcutPreference
+@JvmOverloads
+constructor(
+    context: Context,
+    attrs: AttributeSet? = null,
+) : ToolbarShortcutPreference(context, attrs) {
+    var isTranslationsFeatureEnabled: Boolean = false
+
+    override val options: List<ShortcutOption>
+        get() = expandedSecondShortcutOptions.filterNot {
+            it.key == ShortcutType.TRANSLATE && !isTranslationsFeatureAvailable
+        }
+
+    override fun readSelectedKey(): String = context.components.settings.toolbarExpandedSecondShortcutKey
+
+    override fun writeSelectedKey(key: String) {
+        context.components.settings.toolbarExpandedSecondShortcutKey = key
+    }
+
+    override fun getToolbarType(): String = EXPANDED_TOOLBAR_TYPE
+
+    override fun getTelemetryToolbarType(): String = EXPANDED_SECOND_TOOLBAR_TYPE
+
+    override fun createShortcutRadioButton(
+        newOption: ShortcutOption,
+        selectedOption: ShortcutOption,
+    ): RadioButtonPreference =
+        RadioButtonPreference(context).apply {
+            key = "second_${newOption.key.value}"
+            title = context.getString(newOption.label)
+            isEnabled = isOptionEnabled(newOption)
+            setCheckedWithoutClickListener(newOption == selectedOption)
+            onClickListener {
+                CustomizationSettings.toolbarShortcutSelection.record(
+                    CustomizationSettings.ToolbarShortcutSelectionExtra(
+                        toolbarType = getTelemetryToolbarType(),
+                        item = newOption.key.value,
+                    )
+                )
+                writeSelectedKey(newOption.key.value)
+                notifyChanged()
+            }
+        }
+
+    override fun getSelectedIconImageView(holder: PreferenceViewHolder): ImageView {
+        val simplePreview = holder.findViewById(R.id.toolbar_simple_shortcut_preview)
+        val simpleNoShortcutPreview = holder.findViewById(R.id.toolbar_simple_no_shortcut_preview)
+        val expandedPreview = holder.findViewById(R.id.toolbar_expanded_shortcut_preview)
+
+        simplePreview.visibility = GONE
+        simpleNoShortcutPreview.visibility = GONE
+        expandedPreview.visibility = VISIBLE
+        expandedPreview.findViewById<View>(R.id.toolbar_expanded_preview)?.visibility = GONE
+        expandedPreview.findViewById<View>(R.id.toolbar_expanded_second_preview)?.visibility = VISIBLE
+        expandedPreview.findViewById<View>(R.id.selected_expanded_shortcut_icon)?.visibility = GONE
+        expandedPreview.findViewById<View>(R.id.second_slot_in_first_preview)?.visibility = GONE
+        val secondIcon = expandedPreview.findViewById<ImageView>(R.id.selected_expanded_second_shortcut_icon)
+        secondIcon.visibility = VISIBLE
+        val firstInSecond = expandedPreview.findViewById<ImageView>(R.id.first_slot_in_second_preview)
+        firstInSecond?.let {
+            val firstKey = context.components.settings.toolbarExpandedShortcutKey
+            val firstOption = expandedShortcutOptions.firstOrNull { it.key.value == firstKey }
+                ?: expandedShortcutOptions.firstOrNull()
+            firstOption?.icon?.let { res -> it.setImageResource(res) }
+            it.visibility = VISIBLE
+            it.alpha = 0.6f
+        }
+
+        return secondIcon
+    }
+
+    private val isTranslationsFeatureAvailable: Boolean
+        get() {
+            val browserStore = this.context.components.core.store
+            val isTranslationEngineSupported = browserStore.state.translationEngine.isEngineSupported ?: false
+
+            return isTranslationEngineSupported &&
+                isTranslationsFeatureEnabled &&
+                FxNimbus.features.translations.value().mainFlowToolbarEnabled
+        }
+}
