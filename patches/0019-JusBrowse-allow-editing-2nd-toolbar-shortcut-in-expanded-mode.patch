 import android.widget.ImageView
@@ -45,6 +46,20 @@ constructor(
         simplePreview.visibility = GONE
         simpleNoShortcutPreview.visibility = GONE
         expandedPreview.visibility = VISIBLE
+        expandedPreview.findViewById<View>(R.id.toolbar_expanded_second_preview)?.visibility = GONE
+        expandedPreview.findViewById<View>(R.id.toolbar_expanded_preview)?.visibility = VISIBLE
+        expandedPreview.findViewById<View>(R.id.selected_expanded_second_shortcut_icon)?.visibility = GONE
+        expandedPreview.findViewById<View>(R.id.selected_expanded_shortcut_icon)?.visibility = VISIBLE
+        expandedPreview.findViewById<View>(R.id.first_slot_in_second_preview)?.visibility = GONE
+        val secondInFirst = expandedPreview.findViewById<ImageView>(R.id.second_slot_in_first_preview)
+        secondInFirst?.let {
+            val secondKey = context.components.settings.toolbarExpandedSecondShortcutKey
+            val secondOption = expandedSecondShortcutOptions.firstOrNull { it.key.value == secondKey }
+                ?: expandedSecondShortcutOptions.firstOrNull()
+            secondOption?.icon?.let { res -> it.setImageResource(res) }
+            it.visibility = VISIBLE
+            it.alpha = 0.6f
+        }
 
         return expandedPreview.findViewById(R.id.selected_expanded_shortcut_icon)
     }
