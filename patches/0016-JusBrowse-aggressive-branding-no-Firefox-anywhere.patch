From 2c8f33b3d181e76c8fb4156fb8d2a3475b995118 Mon Sep 17 00:00:00 2001
From: JusDots <eng@jusdots.com>
Date: Mon, 14 Sep 2026 19:56:42 +0530
Subject: [PATCH 16/18] =?UTF-8?q?JusBrowse:=20aggressive=20branding=20?=
 =?UTF-8?q?=E2=80=94=20no=20Firefox=20anywhere?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- strings.xml: View Github Repo (was Rate on Google Play), about_content JusBrowse by JusDots, bulk replace Firefox->JusBrowse / Mozilla->JusDots inside <string> values.
- SettingsFragment: pref_key_rate now opens https://github.com/shubh72010/JusBrowse-Mulberry/tree/Fenix-Version via openInNewTab.
- fragment_about.xml: wordmark 120dp @drawable/ic_launcher_foreground (JusDots monochrome circles) instead of ?fenixLogo.
- launcher: ic_launcher_foreground + ic_launcher_monochrome -> 8-circle Monochrome vector (588 viewport, stroke 18, #262626) from Downloads/Monochrome.svg.
- splash/status: ic_splash_logo + ic_status_logo -> same circles.
---
 .../fenix/settings/SettingsFragment.kt        |   7 +-
 .../res/drawable/ic_launcher_foreground.xml   |  66 ++++---
 .../res/drawable/ic_launcher_monochrome.xml   |  56 ++++--
 .../src/main/res/drawable/ic_splash_logo.xml  |  57 ++++--
 .../src/main/res/drawable/ic_status_logo.xml  |  53 +++++-
 .../src/main/res/layout/fragment_about.xml    |   9 +-
 .../fenix/app/src/main/res/values/strings.xml | 170 +++++++++---------
 7 files changed, 266 insertions(+), 152 deletions(-)

diff --git a/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SettingsFragment.kt b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SettingsFragment.kt
index 9a1ff6febcaf..7b1a5d8e8b0a 100644
--- a/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SettingsFragment.kt
+++ b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SettingsFragment.kt
@@ -567,11 +567,10 @@ class SettingsFragment : PreferenceFragmentCompat(), SystemInsetsPaddedFragment
                     SettingsFragmentDirections.actionSettingsFragmentToSyncDebugFragment()
                 }
 
-                // About preferences
+                // JusBrowse: View Github Repo
                 resources.getString(R.string.pref_key_rate) -> {
-                    components.playStoreReviewPromptController.tryLaunchPlayStoreReview(
-                        requireActivity(),
-                        ::openInNewTab,
+                    openInNewTab(
+                        "https://github.com/shubh72010/JusBrowse-Mulberry/tree/Fenix-Version",
                     )
                     null
                 }
