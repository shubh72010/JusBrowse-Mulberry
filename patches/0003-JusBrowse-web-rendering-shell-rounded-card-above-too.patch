 import kotlinx.coroutines.launch
 import kotlinx.coroutines.withContext
 import mozilla.components.browser.state.selector.selectedTab
+import mozilla.components.browser.state.state.BrowserState
 import mozilla.components.browser.state.state.CustomTabSessionState
+import mozilla.components.lib.state.ext.flow
 import mozilla.components.browser.state.state.SessionState
 import mozilla.components.browser.state.state.TabSessionState
 import mozilla.components.browser.state.state.selectedOrDefaultSearchEngine
@@ -158,6 +160,102 @@ class BrowserFragment : BaseBrowserFragment(), UserInteractionHandler, SystemIns
     override fun initializeUI(view: View, tab: SessionState) {
         super.initializeUI(view, tab)
 
+        runCatching {
+            val swipeRefreshView: View? = view.findViewById<View>(org.mozilla.fenix.R.id.swipeRefresh)
+            swipeRefreshView?.apply {
+                clipToOutline = true
+                outlineProvider = android.view.ViewOutlineProvider.BACKGROUND
+            }
+            view.findViewById<View>(org.mozilla.fenix.R.id.jusBrowsePill)?.visibility = View.GONE
+            view.post {
+                val parent = binding.browserLayout
+                val dp10 = (10 * resources.displayMetrics.density).toInt()
+                val store = requireContext().components.core.store
+                fun isPdfTab(): Boolean {
+                    val tab = store.state.selectedTab
+                    return tab?.content?.isPdf == true || tab?.content?.url?.startsWith("content://") == true
+                }
+                // initial 10dp to avoid flash, then PreDraw will handle toolbar
+                (swipeRefreshView?.layoutParams as? androidx.coordinatorlayout.widget.CoordinatorLayout.LayoutParams)?.let { lp ->
+                    if (lp.topMargin != dp10 || lp.leftMargin != dp10 || lp.rightMargin != dp10) {
+                        lp.topMargin = dp10
+                        lp.leftMargin = dp10
+                        lp.rightMargin = dp10
+                        // bottom handled by PreDraw
+                    }
+                }
+                // JusBrowse shell sits above the toolbar, so drop the legacy
+                // inner padding that assumed web content slides under it.
+                _bottomToolbarContainerView?.toolbarContainerView?.let { v ->
+                    v.setPadding(0, 0, 0, 0)
+                    v.clipToPadding = false
+                }
+                _browserToolbar?.layout?.let { v ->
+                    v.setPadding(0, 0, 0, 0)
+                }
+                parent.setPadding(0, 0, 0, 0)
+                parent.clipToPadding = false
+                parent.viewTreeObserver.addOnPreDrawListener {
+                    val swipeView = swipeRefreshView ?: return@addOnPreDrawListener true
+                    // PDF: shell sits 10dp from screen, no toolbar gap – toolbar draws over shell background
+                    if (isPdfTab()) {
+                        (swipeView.layoutParams as? androidx.coordinatorlayout.widget.CoordinatorLayout.LayoutParams)?.let { lp ->
+                            if (lp.topMargin != dp10 || lp.bottomMargin != dp10 || lp.leftMargin != dp10 || lp.rightMargin != dp10) {
+                                lp.topMargin = dp10
+                                lp.bottomMargin = dp10
+                                lp.leftMargin = dp10
+                                lp.rightMargin = dp10
+                                swipeView.requestLayout()
+                            }
+                        }
+                        return@addOnPreDrawListener true
+                    }
+                    val toolbars = mutableListOf<View>()
+                    fun collect(vg: android.view.ViewGroup) {
+                        for (i in 0 until vg.childCount) {
+                            val child = vg.getChildAt(i)
+                            if (child is mozilla.components.concept.toolbar.ScrollableToolbar) toolbars.add(child)
+                            if (child is android.view.ViewGroup) collect(child)
+                        }
+                    }
+                    collect(parent)
+                    var bottomVisible = 0
+                    for (tb in toolbars) {
+                        if (!tb.isShown) continue
+                        if (tb.top >= parent.height / 2) {
+                            bottomVisible = (tb.height - tb.translationY).toInt().coerceIn(0, tb.height)
+                        }
+                    }
+                    (swipeView.layoutParams as? androidx.coordinatorlayout.widget.CoordinatorLayout.LayoutParams)?.let { lp ->
+                        val newTop = dp10
+                        val newBottom = if (bottomVisible > 0) bottomVisible + dp10 else dp10
+                        if (lp.topMargin != newTop || lp.bottomMargin != newBottom || lp.leftMargin != dp10 || lp.rightMargin != dp10) {
+                            lp.topMargin = newTop
+                            lp.bottomMargin = newBottom
+                            lp.leftMargin = dp10
+                            lp.rightMargin = dp10
+                            swipeView.requestLayout()
+                        }
+                    }
+                    true
+                }
+            }
+            val emptyHint = view.findViewById<View>(org.mozilla.fenix.R.id.jusBrowseEmptyHint)
+            if (emptyHint != null) {
+                val store = requireContext().components.core.store
+                viewLifecycleOwner.lifecycleScope.launch {
+                    store.flow().collect { state: BrowserState ->
+                        val tab = state.selectedTab
+                        val url = tab?.content?.url.orEmpty()
+                        val title = tab?.content?.title?.trim().orEmpty()
+                        val isEmpty = (url == "about:blank" || url == "about:home" || url.isBlank()) && title.isBlank()
+                        emptyHint.visibility = if (isEmpty) View.VISIBLE else View.GONE
+                        if (isEmpty) emptyHint.bringToFront()
+                    }
+                }
+            }
+        }
+
         val context = requireContext()
         val components = context.components
         val settings = components.settings
