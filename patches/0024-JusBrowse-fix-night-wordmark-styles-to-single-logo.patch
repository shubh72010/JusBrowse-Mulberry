From 8366dbc42b9902f671ec356aa2b5286ad5abb226 Mon Sep 17 00:00:00 2001
From: Shubh <shubhaggarwalva@gmail.com>
Date: Tue, 15 Sep 2026 12:53:51 +0530
Subject: [PATCH] JusBrowse: fix night wordmark styles to use single logo

Update values-night/styles.xml and values-night-v27/styles.xml
fenixWordmarkText -> ic_launcher_foreground (was ic_wordmark_text_private
which was deleted in previous logo cleanup). Covers debug+release night
themes.
---
 .../android/fenix/app/src/main/res/values-night-v27/styles.xml  | 2 +-
 mobile/android/fenix/app/src/main/res/values-night/styles.xml   | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/mobile/android/fenix/app/src/main/res/values-night-v27/styles.xml b/mobile/android/fenix/app/src/main/res/values-night-v27/styles.xml
index ce769d9e95ca..2cdde36a25e0 100644
--- a/mobile/android/fenix/app/src/main/res/values-night-v27/styles.xml
+++ b/mobile/android/fenix/app/src/main/res/values-night-v27/styles.xml
@@ -6,7 +6,7 @@
     <style name="NormalTheme" parent="NormalThemeBase" >
         <!-- We have to pull in the changes from night/styles.xml to make
             sure we also get them in night-v27+ -->
-        <item name="fenixWordmarkText">@drawable/ic_wordmark_text_private</item>
+        <item name="fenixWordmarkText">@drawable/ic_launcher_foreground</item>
         
         <item name="android:windowLayoutInDisplayCutoutMode">default</item>
     </style>
diff --git a/mobile/android/fenix/app/src/main/res/values-night/styles.xml b/mobile/android/fenix/app/src/main/res/values-night/styles.xml
index 388295b3d335..3285637c205a 100644
--- a/mobile/android/fenix/app/src/main/res/values-night/styles.xml
+++ b/mobile/android/fenix/app/src/main/res/values-night/styles.xml
@@ -6,7 +6,7 @@
     <style name="DialogStyleNormal" parent="BaseDialogStyle"/>
 
     <style name="NormalTheme" parent="NormalThemeBase" >
-        <item name="fenixWordmarkText">@drawable/ic_wordmark_text_private</item>
+        <item name="fenixWordmarkText">@drawable/ic_launcher_foreground</item>
     </style>
     <style name="BottomSheet" parent="BottomSheetBase">
         <item name="android:windowLightStatusBar">false</item>
-- 
2.55.0

