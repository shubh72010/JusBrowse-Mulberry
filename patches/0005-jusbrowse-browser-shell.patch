 .../mozilla/fenix/jusbrowse/BrowserShell.kt   | 107 ++++++++++++++++++
 .../main/res/drawable/jusbrowse_card_bg.xml   |   6 +
 .../src/main/res/layout/fragment_browser.xml  |  31 ++++-
 4 files changed, 173 insertions(+), 2 deletions(-)
 create mode 100644 mobile/android/fenix/app/src/main/java/org/mozilla/fenix/jusbrowse/BrowserShell.kt
 create mode 100644 mobile/android/fenix/app/src/main/res/drawable/jusbrowse_card_bg.xml

