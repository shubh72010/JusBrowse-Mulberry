+private val SUGGESTION_GAP = 2.dp
+private val SUGGESTION_HORIZONTAL_INSET = 12.dp
+private val GROUP_TITLE_TOP_GAP = 14.dp
+
+// Corner radii mirror Fenix segmented lists (SegmentedList.segmentedShape).
+private val SEGMENTED_LARGE_CORNER = 28.dp
+private val SEGMENTED_SMALL_CORNER = 6.dp
+
+private fun segmentedSuggestionShape(index: Int, count: Int): Shape =
+    when {
+        count <= 1 -> RoundedCornerShape(SEGMENTED_LARGE_CORNER)
+        index == 0 ->
+            RoundedCornerShape(
+                topStart = SEGMENTED_LARGE_CORNER,
+                topEnd = SEGMENTED_LARGE_CORNER,
+                bottomEnd = SEGMENTED_SMALL_CORNER,
+                bottomStart = SEGMENTED_SMALL_CORNER,
+            )
+        index == count - 1 ->
+            RoundedCornerShape(
+                topStart = SEGMENTED_SMALL_CORNER,
+                topEnd = SEGMENTED_SMALL_CORNER,
+                bottomEnd = SEGMENTED_LARGE_CORNER,
+                bottomStart = SEGMENTED_LARGE_CORNER,
+            )
+        else -> RoundedCornerShape(SEGMENTED_SMALL_CORNER)
+    }
+
+@Composable
+private fun SegmentedSuggestionCard(
+    index: Int,
+    count: Int,
+    content: @Composable () -> Unit,
+) {
+    Card(
+        shape = segmentedSuggestionShape(index = index, count = count),
+        colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surfaceContainerLow),
+        elevation = CardDefaults.cardElevation(defaultElevation = 0.dp),
+        modifier = Modifier.fillMaxWidth(),
+    ) {
+        content()
+    }
+}
