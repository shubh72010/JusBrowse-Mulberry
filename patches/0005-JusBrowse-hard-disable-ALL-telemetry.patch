From 94445bb44d28b9c3ca94e2c085cd7fcb21b53e62 Mon Sep 17 00:00:00 2001
From: JusDots <eng@jusdots.com>
Date: Mon, 14 Sep 2026 19:31:38 +0530
Subject: [PATCH 05/13] JusBrowse: hard-disable ALL telemetry

No data sent to Mozilla: Glean/adjust/metrics services stubbed.
---
 .../org/mozilla/fenix/FenixApplication.kt     |  8 +--
 .../org/mozilla/fenix/components/Analytics.kt | 65 +++----------------
 .../mozilla/fenix/components/GleanHelper.kt   |  9 ++-
 .../metrics/AdjustMetricsService.kt           | 14 +---
 .../components/metrics/GleanMetricsService.kt | 22 +------
 .../components/metrics/MetricController.kt    | 13 +---
 .../java/org/mozilla/fenix/utils/Settings.kt  | 13 ++--
 7 files changed, 30 insertions(+), 114 deletions(-)

diff --git a/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/FenixApplication.kt b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/FenixApplication.kt
index 9fe673ba8f2d..75c92cfe7742 100644
--- a/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/FenixApplication.kt
+++ b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/FenixApplication.kt
@@ -304,11 +304,9 @@ open class FenixApplication : Application(), Provider, ThemeProvider {
     // wait until we do. Note that Glean initialization is asynchronous any may not be finished
     // when this method returns.
     private fun maybeInitializeGlean() {
-        // We delay the Glean initialization until we have user consent from onboarding.
-        // If onboarding is disabled (when in local builds), continue to initialize Glean.
-        if (components.fenixOnboarding.userHasBeenOnboarded() || !FeatureFlags.onboardingFeatureEnabled) {
-            initializeGlean(this, logger, components.settings.isTelemetryEnabled, components.core.client)
-        }
+        // JusBrowse: telemetry hard-disabled — init Glean with uploadEnabled=false
+        initializeGlean(this, logger, false, components.core.client)
+        mozilla.telemetry.glean.Glean.setCollectionEnabled(false)
     }
 
     /**
