@@ -97,17 +97,8 @@ interface MetricController {
             isUsageTelemetryEnabled: () -> Boolean,
             settings: Settings,
         ): MetricController {
-            return if (BuildConfig.TELEMETRY) {
-                ReleaseMetricController(
-                    services,
-                    isDataTelemetryEnabled,
-                    isMarketingDataTelemetryEnabled,
-                    isUsageTelemetryEnabled,
-                    settings,
-                )
-            } else {
-                DebugMetricController()
-            }
+            // JusBrowse: hard-disable — always no-op, never send telemetry regardless of build type
+            return DebugMetricController()
         }
     }
 }
