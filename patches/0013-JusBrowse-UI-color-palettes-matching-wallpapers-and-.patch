+/**
+ * Switches the launcher icon to match the given JusBrowse color palette.
+ * Unknown values fall back to the default icon.
+ */
+fun Context.applyPaletteLauncherIcon(palette: String) {
+    val target =
+        when (palette) {
+            JusBrowsePalettes.CATPPUCCIN -> AppIcon.AppCatppuccin.aliasSuffix
+            JusBrowsePalettes.TOKYO_NIGHT -> AppIcon.AppTokyoNight.aliasSuffix
+            JusBrowsePalettes.GRUVBOX -> AppIcon.AppGruvbox.aliasSuffix
+            JusBrowsePalettes.NORD -> AppIcon.AppNord.aliasSuffix
+            JusBrowsePalettes.DRACULA -> AppIcon.AppDracula.aliasSuffix
+            JusBrowsePalettes.ROSE_PINE -> AppIcon.AppRosePine.aliasSuffix
+            else -> AppIcon.AppDefault.aliasSuffix
+        }
+    val packageManager = packageManager
+    packageManager.setComponentEnabledSetting(
+        ComponentName(packageName, "$packageName.$target"),
+        PackageManager.COMPONENT_ENABLED_STATE_ENABLED,
+        PackageManager.DONT_KILL_APP,
+    )
+    for (icon in AppIcon.entries) {
+        if (icon.aliasSuffix != target) {
+            packageManager.setComponentEnabledSetting(
+                ComponentName(packageName, "$packageName.${icon.aliasSuffix}"),
+                PackageManager.COMPONENT_ENABLED_STATE_DISABLED,
+                PackageManager.DONT_KILL_APP,
+            )
+        }
+    }
+}
