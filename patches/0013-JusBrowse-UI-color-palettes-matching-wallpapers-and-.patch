+                    primary = Color(0xFFC4A7E7),
+                    onPrimary = Color(0xFF191724),
+                    secondary = Color(0xFFEBBCBA),
+                    onSurface = Color(0xFFE0DEF4),
+                ),
+        )
+
+    private val lightPalettes =
+        mapOf(
+            CATPPUCCIN to
+                Palette(
+                    background = Color(0xFFEFF1F5),
+                    surface = Color(0xFFE6E9EF),
+                    surfaceHigh = Color(0xFFDCE0E8),
+                    container = Color(0xFFD9D4F2),
+                    primary = Color(0xFF8839EF),
+                    onPrimary = Color(0xFFEFF1F5),
+                    secondary = Color(0xFFEA76CB),
+                    onSurface = Color(0xFF4C4F69),
+                ),
+            TOKYO_NIGHT to
+                Palette(
+                    background = Color(0xFFE1E2E7),
+                    surface = Color(0xFFD2D6E4),
+                    surfaceHigh = Color(0xFFC4C8DA),
+                    container = Color(0xFFC9D6F2),
+                    primary = Color(0xFF2E7DE9),
+                    onPrimary = Color(0xFFE1E2E7),
+                    secondary = Color(0xFF9854F1),
+                    onSurface = Color(0xFF343B58),
+                ),
+            GRUVBOX to
+                Palette(
+                    background = Color(0xFFFBF1C7),
+                    surface = Color(0xFFEBDBB2),
+                    surfaceHigh = Color(0xFFD5C4A1),
+                    container = Color(0xFFE7D5AE),
+                    primary = Color(0xFFAF3A03),
+                    onPrimary = Color(0xFFFBF1C7),
+                    secondary = Color(0xFFB57614),
+                    onSurface = Color(0xFF3C3836),
+                ),
+            NORD to
+                Palette(
+                    background = Color(0xFFECEFF4),
+                    surface = Color(0xFFE5E9F0),
+                    surfaceHigh = Color(0xFFD8DEE9),
+                    container = Color(0xFFCFD8E3),
+                    primary = Color(0xFF5E81AC),
+                    onPrimary = Color(0xFFECEFF4),
+                    secondary = Color(0xFFB48EAD),
+                    onSurface = Color(0xFF2E3440),
+                ),
+            DRACULA to
+                Palette(
+                    background = Color(0xFFF8F8F2),
+                    surface = Color(0xFFEDE9F6),
+                    surfaceHigh = Color(0xFFDDD6F0),
+                    container = Color(0xFFD5CBF0),
+                    primary = Color(0xFF7157C7),
+                    onPrimary = Color(0xFFF8F8F2),
+                    secondary = Color(0xFFC8508A),
+                    onSurface = Color(0xFF282A36),
+                ),
+            ROSE_PINE to
+                Palette(
+                    background = Color(0xFFFAF4ED),
+                    surface = Color(0xFFFFFAF3),
+                    surfaceHigh = Color(0xFFF2E9E1),
+                    container = Color(0xFFE5D5DC),
+                    primary = Color(0xFF907AA9),
+                    onPrimary = Color(0xFFFAF4ED),
+                    secondary = Color(0xFFD7827E),
+                    onSurface = Color(0xFF575279),
+                ),
+        )
+
+    fun ColorScheme.withPalette(name: String, light: Boolean = false): ColorScheme {
+        val palette = (if (light) lightPalettes else palettes)[name] ?: return this
+        return copy(
+            background = palette.background,
+            onBackground = palette.onSurface,
+            surface = palette.surface,
+            onSurface = palette.onSurface,
+            surfaceVariant = palette.surfaceHigh,
+            surfaceContainer = palette.surface,
+            surfaceContainerHigh = palette.surfaceHigh,
+            surfaceContainerHighest = palette.container,
+            primary = palette.primary,
+            onPrimary = palette.onPrimary,
+            primaryContainer = palette.container,
+            secondary = palette.secondary,
+            onSecondary = palette.onPrimary,
+            tertiary = palette.secondary,
+            onTertiary = palette.onPrimary,
+            tertiaryContainer = palette.container,
+        )
+    }
+
+    fun AcornColors.withAcornPalette(name: String, light: Boolean = false): AcornColors {
+        val palette = (if (light) lightPalettes else palettes)[name] ?: return this
+        return copy(
+            formDefault = palette.primary,
+            surfaceContainerSelected = palette.container,
+            autofillText = palette.primary,
+            selectedText = palette.primary,
+            sheetOutline = palette.surfaceHigh,
+        )
+    }
+
+    @StyleRes
+    fun overlay(name: String, light: Boolean): Int {
+        if (light) {
+            return when (name) {
+                CATPPUCCIN -> R.style.JusBrowsePaletteLight_Catppuccin
+                TOKYO_NIGHT -> R.style.JusBrowsePaletteLight_TokyoNight
+                GRUVBOX -> R.style.JusBrowsePaletteLight_Gruvbox
+                NORD -> R.style.JusBrowsePaletteLight_Nord
+                DRACULA -> R.style.JusBrowsePaletteLight_Dracula
+                ROSE_PINE -> R.style.JusBrowsePaletteLight_RosePine
+                else -> 0
+            }
+        }
+        return when (name) {
+            CATPPUCCIN -> R.style.JusBrowsePalette_Catppuccin
+            TOKYO_NIGHT -> R.style.JusBrowsePalette_TokyoNight
+            GRUVBOX -> R.style.JusBrowsePalette_Gruvbox
+            NORD -> R.style.JusBrowsePalette_Nord
+            DRACULA -> R.style.JusBrowsePalette_Dracula
+            ROSE_PINE -> R.style.JusBrowsePalette_RosePine
+            else -> 0
+        }
+    }
+}
