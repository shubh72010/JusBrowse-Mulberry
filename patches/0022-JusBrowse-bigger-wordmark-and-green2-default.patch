From cac1bcfcf46968d7388108068274c94347255945 Mon Sep 17 00:00:00 2001
From: Shubh <shubhaggarwalva@gmail.com>
Date: Tue, 15 Sep 2026 12:29:14 +0530
Subject: [PATCH] JusBrowse: bigger JusBrowse wordmark and green2 default
 wallpaper

- WordmarkText 22.sp Bold -> 28.sp ExtraBold -0.8 spacing
- Settings currentWallpaperName default -> green2
- WallpapersUseCases fallback to green2 when no current wallpaper
---
 .../src/main/java/org/mozilla/fenix/home/ui/Wordmark.kt    | 6 +++---
 .../app/src/main/java/org/mozilla/fenix/utils/Settings.kt  | 7 +------
 .../org/mozilla/fenix/wallpapers/WallpapersUseCases.kt     | 1 +
 3 files changed, 5 insertions(+), 9 deletions(-)

diff --git a/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/ui/Wordmark.kt b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/ui/Wordmark.kt
index 90f70dad69f3..79d1bb885715 100644
--- a/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/ui/Wordmark.kt
+++ b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/ui/Wordmark.kt
@@ -55,8 +55,8 @@ internal fun WordmarkText(color: Color?) {
                 testTag = HOMEPAGE_WORDMARK_TEXT
             },
         color = color ?: MaterialTheme.colorScheme.onSurface,
-        fontSize = 22.sp,
-        fontWeight = FontWeight.Bold,
-        letterSpacing = (-0.5).sp,
+        fontSize = 28.sp,
+        fontWeight = FontWeight.ExtraBold,
+        letterSpacing = (-0.8).sp,
     )
 }
diff --git a/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt
index 4232affbd5b3..3a2f3e5987b1 100644
--- a/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt
+++ b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt
@@ -576,12 +576,7 @@ class Settings(
     var currentWallpaperName by
         stringPreference(
             appContext.getPreferenceKey(R.string.pref_key_current_wallpaper),
-            default =
-                if (enableHomepageEdgeToEdgeBackgroundFeature) {
-                    Wallpaper.EdgeToEdge.name
-                } else {
-                    Wallpaper.Default.name
-                },
+            default = "green2",
         )
 
     /**
diff --git a/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/wallpapers/WallpapersUseCases.kt b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/wallpapers/WallpapersUseCases.kt
index c71db4621097..19358faa9595 100644
--- a/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/wallpapers/WallpapersUseCases.kt
+++ b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/wallpapers/WallpapersUseCases.kt
@@ -153,6 +153,7 @@ class WallpapersUseCases(
                 allAvailable.find { it.name == currentWallpaperName }
                     ?: fileManager.lookupExpiredWallpaper(settings)
                     ?: Wallpaper.getCurrentWallpaperFromSettings(settings)
+                    ?: jusBrowseWallpapers.find { it.name == "green2" }
                     ?: Wallpaper.Default
 
             // Dispatching this early will make it accessible to the home screen ASAP. This may have
-- 
2.55.0

