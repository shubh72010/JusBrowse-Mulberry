From 3c7ccf5cecb72154017bc2c12373bdf046564e36 Mon Sep 17 00:00:00 2001
From: JusDots <eng@jusdots.com>
Date: Mon, 14 Sep 2026 18:00:20 +0530
Subject: [PATCH 07/18] fix: web rendering under bottom toolbar + hide pill
 (dotpill removal per request)

---
 .../java/org/mozilla/fenix/browser/BrowserFragment.kt    | 9 +++------
 .../fenix/app/src/main/res/layout/fragment_browser.xml   | 1 -
 2 files changed, 3 insertions(+), 7 deletions(-)

diff --git a/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BrowserFragment.kt b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BrowserFragment.kt
index 29f18cdc4e65..ffa05ffe5ba8 100644
--- a/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BrowserFragment.kt
+++ b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BrowserFragment.kt
@@ -164,13 +164,10 @@ class BrowserFragment : BaseBrowserFragment(), UserInteractionHandler, SystemIns
             view.findViewById<View>(org.mozilla.fenix.R.id.swipeRefresh)?.apply {
                 clipToOutline = true
                 outlineProvider = android.view.ViewOutlineProvider.BACKGROUND
+                (layoutParams as? androidx.coordinatorlayout.widget.CoordinatorLayout.LayoutParams)?.behavior = null
             }
-            val pill = view.findViewById<androidx.compose.ui.platform.ComposeView>(org.mozilla.fenix.R.id.jusBrowsePill)
-            pill?.setContent {
-                org.mozilla.fenix.theme.FirefoxTheme {
-                    org.mozilla.fenix.jusbrowse.JusBrowseBrowserPill()
-                }
-            }
+            view.findViewById<View>(org.mozilla.fenix.R.id.jusBrowsePill)?.visibility = View.GONE
+            view.findViewById<View>(org.mozilla.fenix.R.id.navigation_bar)?.visibility = View.GONE
             _browserToolbar?.layout?.visibility = View.GONE
             _bottomToolbarContainerView?.toolbarContainerView?.visibility = View.GONE
             val emptyHint = view.findViewById<View>(org.mozilla.fenix.R.id.jusBrowseEmptyHint)
diff --git a/mobile/android/fenix/app/src/main/res/layout/fragment_browser.xml b/mobile/android/fenix/app/src/main/res/layout/fragment_browser.xml
index cf11ed3075b7..50bb4bb8a836 100644
--- a/mobile/android/fenix/app/src/main/res/layout/fragment_browser.xml
+++ b/mobile/android/fenix/app/src/main/res/layout/fragment_browser.xml
@@ -45,7 +45,6 @@
                 android:layout_width="match_parent"
                 android:layout_height="match_parent"
                 android:layout_margin="10dp"
-                android:layout_marginBottom="76dp"
                 android:background="@drawable/jusbrowse_card_bg"
                 android:clipToOutline="true"
                 android:elevation="0dp">
-- 
2.55.0

