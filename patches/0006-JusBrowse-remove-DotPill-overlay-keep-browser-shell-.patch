-private const val PILL_MIN_W = 260
-private const val PILL_MAX_W = 360
-private const val PILL_H_COLLAPSED = 56
-private const val PILL_H_MENU = 420
-
-@Composable
-fun JusBrowseDotPill(
-    modifier: Modifier = Modifier,
-    onNewTab: () -> Unit = {},
-    onSettings: () -> Unit = {},
-) {
-    val context = LocalContext.current
-    val store = context.components.core.store
-    val state by store.observeAsComposableState { it }
-    val tab = state.selectedTab
-    val url = tab?.content?.url ?: ""
-    val canBack = tab?.content?.canGoBack == true
-    val canForward = tab?.content?.canGoForward == true
-    val isSecure = url.startsWith("https://")
-    val host = url.removePrefix("https://").removePrefix("http://").substringBefore("/").takeIf { it != "about:blank" && it.isNotBlank() } ?: ""
-    val fullUrl = if (url == "about:blank" || url == "about:home") "" else url
-
-    val engine = remember { PillGestureEngine() }
-    val focusRequester = remember { FocusRequester() }
-    val focusManager = LocalFocusManager.current
-    var text by remember { mutableStateOf("") }
-    var hasFocus by remember { mutableStateOf(false) }
-
-    LaunchedEffect(tab?.id, fullUrl, engine.isExpandedOrMenu) {
-        if (!engine.isExpandedOrMenu) text = fullUrl
-    }
-    LaunchedEffect(engine.snapState) {
-        if (engine.snapState == PillSnapState.EXPANDED) {
-            kotlinx.coroutines.delay(80)
-            focusRequester.requestFocus()
-        }
-    }
-
-    val isMenu = engine.isMenuOpen
-    val isExpanded = engine.isExpandedOrMenu
-    val level = when {
-        isMenu -> 2f
-        isExpanded -> 1f
-        else -> 0f
-    }
-    val animLevel by animateFloatAsState(level, spring(dampingRatio = Spring.DampingRatioMediumBouncy, stiffness = Spring.StiffnessLow), label = "pillLevel")
-    val effective = if (engine.isDragging) engine.dragProgress else animLevel.coerceIn(0f, 1f).let { if (isMenu) 1f else it }
-    val width = PILL_MIN_W.dp + (PILL_MAX_W - PILL_MIN_W).dp * effective.coerceIn(0f, 1f)
-    val height = if (animLevel <= 1f) PILL_H_COLLAPSED.dp else PILL_H_COLLAPSED.dp + (PILL_H_MENU - PILL_H_COLLAPSED).dp * (animLevel - 1f)
-    val corner = 28.dp + 4.dp * animLevel.coerceIn(0f, 1f)
-    val scrim = if (isExpanded) 0.6f else 0f
-    val offsetX = if (engine.isDragging) (engine.rawXOffset * 0.6f).roundToInt() else 0
-    val offsetY = if (engine.isDragging) (engine.rawYOffset.coerceAtMost(0f) * 0.4f).roundToInt() else 0
-
-    fun doSearch(query: String) {
-        val q = query.trim()
-        if (q.isEmpty()) return
-        val searchEngine = context.components.appStore.state.searchState.selectedSearchEngine?.searchEngine
-            ?: store.state.search.selectedOrDefaultSearchEngine
-        val isPrivate = tab?.content?.private ?: context.components.appStore.state.mode.isPrivate
-        context.components.useCases.fenixBrowserUseCases.loadUrlOrSearch(
-            searchTermOrURL = q,
-            newTab = false,
-            searchEngine = searchEngine,
-            private = isPrivate,
-        )
-        engine.dismissMenu()
-        focusManager.clearFocus()
-    }
-
-    Box(Modifier.fillMaxSize()) {
-        if (scrim > 0f) {
-            Box(Modifier.fillMaxSize().background(Color.Black.copy(scrim)).clickable(remember { MutableInteractionSource() }, null) {
-                engine.dismissMenu(); focusManager.clearFocus()
-            })
-        }
-        Box(
-            modifier
-                .align(Alignment.BottomCenter)
-                .navigationBarsPadding()
-                .imePadding()
-                .padding(bottom = 12.dp)
-                .offset { IntOffset(offsetX, offsetY) }
-                .width(width).height(height)
-                .shadow(12.dp, RoundedCornerShape(corner))
-                .border(BorderStroke(1.2.dp, Brush.linearGradient(listOf(MaterialTheme.colorScheme.primary.copy(0.45f), Color.White.copy(0.18f), MaterialTheme.colorScheme.secondary.copy(0.22f)))), RoundedCornerShape(corner))
-                .clip(RoundedCornerShape(corner))
-                .background(if (isMenu) MaterialTheme.colorScheme.surface.copy(0.98f) else MaterialTheme.colorScheme.surface.copy(0.92f))
-                .then(if (!isExpanded) Modifier.combinedClickable(onClick = { engine.toggleExpand() }, onLongClick = { tab?.id?.let { context.components.useCases.sessionUseCases.reload.invoke(it) } }) else Modifier)
-                .pointerInput(Unit) {
-                    detectDragGestures(
-                        onDragStart = { engine.onDragStart() },
-                        onDrag = { c, a -> c.consume(); engine.onDrag(a.y, a.x) },
-                        onDragEnd = {
-                            val x = engine.rawXOffset
-                            if (x > 150f && canBack) state.selectedTab?.id?.let { context.components.useCases.sessionUseCases.goBack.invoke(it) }
-                            else if (x < -150f && canForward) state.selectedTab?.id?.let { context.components.useCases.sessionUseCases.goForward.invoke(it) }
-                            engine.onDragEnd()
-                        },
-                    )
-                },
-        ) {
-            AnimatedContent(
-                targetState = if (isMenu) 2 else if (isExpanded) 1 else 0,
-                transitionSpec = { (fadeIn(tween(180)) + scaleIn(initialScale = 0.92f)) togetherWith (fadeOut(tween(90)) + scaleOut(targetScale = 0.92f)) },
-                label = "pill",
-            ) { s ->
-                when (s) {
-                    0 -> Box(Modifier.fillMaxSize(), Alignment.Center) { Box(Modifier.size(12.dp).clip(CircleShape).background(MaterialTheme.colorScheme.primary)) }
-                    1 -> Row(Modifier.fillMaxSize().padding(horizontal = 6.dp), verticalAlignment = Alignment.CenterVertically) {
-                        IconButton(onClick = { tab?.id?.let { context.components.useCases.sessionUseCases.goBack.invoke(it) } }, enabled = canBack, modifier = Modifier.size(32.dp)) { Icon(Icons.AutoMirrored.Filled.ArrowBack, null, Modifier.size(18.dp)) }
-                        IconButton(onClick = { tab?.id?.let { context.components.useCases.sessionUseCases.goForward.invoke(it) } }, enabled = canForward, modifier = Modifier.size(32.dp)) { Icon(Icons.AutoMirrored.Filled.ArrowForward, null, Modifier.size(18.dp)) }
-                        if (isSecure) { Icon(Icons.Filled.Lock, null, Modifier.size(14.dp), tint = MaterialTheme.colorScheme.primary); Spacer(Modifier.width(6.dp)) }
-                        BasicTextField(
-                            value = text,
-                            onValueChange = { text = it },
-                            modifier = Modifier.weight(1f).focusRequester(focusRequester).onFocusChanged { hasFocus = it.isFocused },
-                            singleLine = true,
-                            textStyle = MaterialTheme.typography.bodyMedium.copy(MaterialTheme.colorScheme.onSurface),
-                            decorationBox = { inner ->
-                                Box {
-                                    if (text.isEmpty()) Text(
-                                        text = if (hasFocus) "Search or enter address" else host.ifBlank { "Search or enter address" },
-                                        maxLines = 1, overflow = TextOverflow.Ellipsis,
-                                        color = if (host.isNotBlank() && !hasFocus) MaterialTheme.colorScheme.onSurface else MaterialTheme.colorScheme.onSurfaceVariant.copy(0.6f),
-                                    )
-                                    inner()
-                                }
-                            },
-                            keyboardOptions = KeyboardOptions(imeAction = ImeAction.Search),
-                            keyboardActions = KeyboardActions(onSearch = { doSearch(text) }),
-                        )
-                        IconButton(onClick = { if (text.isNotEmpty()) text = "" else doSearch(text) }, modifier = Modifier.size(32.dp)) { Icon(if (text.isNotEmpty()) Icons.Filled.Close else Icons.Filled.Search, null, Modifier.size(18.dp)) }
-                    }
-                    else -> {
-                        val scroll = rememberScrollState()
-                        Column(Modifier.fillMaxSize().verticalScroll(scroll).padding(16.dp), horizontalAlignment = Alignment.CenterHorizontally) {
-                            Box(Modifier.size(32.dp, 4.dp).clip(CircleShape).background(MaterialTheme.colorScheme.onSurfaceVariant.copy(0.4f)).clickable { engine.dismissMenu() })
-                            Spacer(Modifier.height(12.dp))
-                            Text("JusBrowse", style = MaterialTheme.typography.titleMedium, color = MaterialTheme.colorScheme.primary)
-                            Spacer(Modifier.height(12.dp))
-                            MenuRow(Icons.Filled.Add, "New tab") { engine.dismissMenu(); onNewTab() }
-                            MenuRow(Icons.Filled.Star, "New private tab") { engine.dismissMenu(); context.components.useCases.tabsUseCases.addTab.invoke(url = "about:blank", private = true, selectTab = true) }
-                            MenuRow(Icons.Filled.Search, "History") { engine.dismissMenu() }
-                            MenuRow(Icons.Filled.Refresh, "Reload") { engine.dismissMenu(); tab?.id?.let { context.components.useCases.sessionUseCases.reload.invoke(it) } }
-                            MenuRow(Icons.Filled.Settings, "Settings") { engine.dismissMenu(); onSettings() }
-                            MenuRow(Icons.Filled.MoreVert, "Close") { engine.dismissMenu() }
-                            Spacer(Modifier.height(16.dp))
-                        }
-                    }
-                }
-            }
-        }
-    }
-}
