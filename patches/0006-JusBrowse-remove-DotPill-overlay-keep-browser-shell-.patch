-package org.mozilla.fenix.jusbrowse
-
-import androidx.compose.runtime.Stable
-import androidx.compose.runtime.getValue
-import androidx.compose.runtime.mutableFloatStateOf
-import androidx.compose.runtime.mutableStateOf
-import androidx.compose.runtime.setValue
-
-enum class PillSnapState { CLOSED, EXPANDING, EXPANDED, MENU_OPEN }
-
-@Stable
-class PillGestureEngine {
-    var snapState by mutableStateOf(PillSnapState.CLOSED); private set
-    var isDragging by mutableStateOf(false); private set
-    var dragProgress by mutableFloatStateOf(0f); private set
-    var gestureProgress by mutableFloatStateOf(0f); private set
-    var rawYOffset by mutableFloatStateOf(0f); private set
-    var rawXOffset by mutableFloatStateOf(0f); private set
-    private var lastFrameMs = 0L
-    private val snapThreshold = 100f
-    private val menuThreshold = 180f
-    fun onDragStart() { rawYOffset = 0f; rawXOffset = 0f; dragProgress = 0f; isDragging = true; snapState = PillSnapState.CLOSED; lastFrameMs = System.currentTimeMillis() }
-    fun onDrag(deltaY: Float, deltaX: Float) {
-        val now = System.currentTimeMillis()
-        if (now - lastFrameMs < 16L) return
-        rawYOffset += deltaY
-        rawXOffset += deltaX
-        dragProgress = (-rawYOffset).coerceAtLeast(0f).div(snapThreshold).coerceAtMost(1f)
-        if (snapState == PillSnapState.CLOSED && dragProgress > 0.05f) snapState = PillSnapState.EXPANDING
-        lastFrameMs = now
-    }
-    fun onDragEnd(): PillSnapState {
-        isDragging = false
-        val up = -rawYOffset
-        snapState = when {
-            up > menuThreshold -> { gestureProgress = 1f; PillSnapState.MENU_OPEN }
-            up > snapThreshold -> { gestureProgress = 1f; PillSnapState.EXPANDED }
-            else -> { gestureProgress = 0f; PillSnapState.CLOSED }
-        }
-        if (snapState == PillSnapState.CLOSED) { rawYOffset = 0f; rawXOffset = 0f; dragProgress = 0f }
-        return snapState
-    }
-    fun dismissMenu() { snapState = PillSnapState.CLOSED; gestureProgress = 0f; dragProgress = 0f; rawYOffset = 0f; rawXOffset = 0f }
-    fun toggleExpand() {
-        if (snapState == PillSnapState.EXPANDED || snapState == PillSnapState.MENU_OPEN) { snapState = PillSnapState.CLOSED; gestureProgress = 0f }
-        else { snapState = PillSnapState.EXPANDED; gestureProgress = 1f }
-    }
-    val isExpandedOrMenu get() = snapState == PillSnapState.EXPANDED || snapState == PillSnapState.MENU_OPEN
-    val isMenuOpen get() = snapState == PillSnapState.MENU_OPEN
-}
